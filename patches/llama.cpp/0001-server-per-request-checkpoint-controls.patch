From 91c0769635d8e213b52e80b194f835ffe6bf7e5a Mon Sep 17 00:00:00 2001
From: QAI <qai@q.local>
Date: Mon, 21 Sep 2026 06:19:03 -0700
Subject: [PATCH] server: per-request checkpoint controls for hybrid and SWA
 models

ctx_checkpoints (default true): when false, the task creates no context
checkpoints and skips the prompt splits they require. Hybrid models otherwise
process the last tokens of every prompt in a separate batch, which costs a
full pass over the weights even when the checkpoint is never reused.

checkpoint_end (default false): process the prompt in one batch and
checkpoint it after its last token, instead of a few tokens earlier. With
n_predict = 0 this primes a prefix that later prompts extend, so they resume
exactly where it ends.
---
 tools/server/server-context.cpp | 18 +++++++++++++++++-
 tools/server/server-schema.cpp  |  6 ++++++
 tools/server/server-task.h      |  2 ++
 3 files changed, 25 insertions(+), 1 deletion(-)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index b6835e4..f09e22b 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -3462,6 +3462,9 @@ private:
                     // make checkpoints only for completion tasks
                     do_checkpoint = do_checkpoint && slot.task->type == SERVER_TASK_TYPE_COMPLETION;
 
+                    // the client can opt out when the end of this prompt will not be reused
+                    do_checkpoint = do_checkpoint && slot.task->params.ctx_checkpoints;
+
                     // make a checkpoint of the parts of the memory that cannot be rolled back.
                     // checkpoints are created only if:
                     // - the model does not support partial sequence removal
@@ -3561,7 +3564,7 @@ private:
                         //  - 4 + n_ubatch
                         //  - 4
                         // ref: https://github.com/ggml-org/llama.cpp/pull/20288
-                        if (do_checkpoint) {
+                        if (do_checkpoint && !slot.task->params.checkpoint_end) {
                             static const int checkpoint_offsets[] = {4 + n_ubatch, 4};
 
                             bool should_break = false;
@@ -3833,6 +3836,19 @@ private:
 
                 GGML_ASSERT(slot.task->need_sampling());
 
+                // the client asked for a checkpoint that covers the whole prompt
+                if (slot.task->params.checkpoint_end && slot.task->params.ctx_checkpoints &&
+                        slot.task->type == SERVER_TASK_TYPE_COMPLETION && params_base.n_ctx_checkpoints > 0 && (
+                            ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
+                            ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS ||
+                            n_swa > 0)) {
+                    const auto pos_min = llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), slot.id);
+                    const auto pos_max = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+                    if (pos_min >= 0) {
+                        create_checkpoint(slot, 0, pos_min, pos_max);
+                    }
+                }
+
                 // prompt evaluated for next-token prediction
                 slot.state = SLOT_STATE_GENERATING;
 
diff --git a/tools/server/server-schema.cpp b/tools/server/server-schema.cpp
index 27ecafb..c310ebb 100644
--- a/tools/server/server-schema.cpp
+++ b/tools/server/server-schema.cpp
@@ -31,6 +31,12 @@ std::vector<std::unique_ptr<field>> make_llama_cmpl_schema(const common_params &
     add((new field_bool("cache_prompt", params.cache_prompt))
         ->set_desc("Re-use KV cache from a previous request if possible. This way the common prefix does not have to be re-processed, only the suffix that differs between the requests"));
 
+    add((new field_bool("ctx_checkpoints", params.ctx_checkpoints))
+        ->set_desc("Allow context checkpoints for this prompt. Hybrid and SWA models process the last tokens of a prompt in a separate batch to checkpoint them; disable when the prompt's end will not be reused"));
+
+    add((new field_bool("checkpoint_end", params.checkpoint_end))
+        ->set_desc("Checkpoint the whole prompt after processing it, in one batch, instead of a few tokens before its end. Use with n_predict = 0 to prime a prefix that later prompts extend"));
+
     add((new field_bool("return_tokens", params.return_tokens))
         ->set_desc("Return the raw generated token ids in the `tokens` field"));
 
diff --git a/tools/server/server-task.h b/tools/server/server-task.h
index 9c99143..3533393 100644
--- a/tools/server/server-task.h
+++ b/tools/server/server-task.h
@@ -51,6 +51,8 @@ struct task_params {
     bool stream          = false;
     bool include_usage   = false;
     bool cache_prompt    = true; // remember the prompt to avoid reprocessing all prompt
+    bool ctx_checkpoints = true; // allow context checkpoints (and the prompt splits they need) for this task
+    bool checkpoint_end  = false; // checkpoint the whole prompt once it is processed, instead of a few tokens before its end
     bool return_tokens   = false;
     bool return_progress = false;
 
